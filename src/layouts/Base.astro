---
import '@fontsource-variable/archivo';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { ui } from '../data/ui';
import type { Lang } from '../data/types';
import { LANGS, langPath, t } from '../lib/i18n';
import { url } from '../lib/assets';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const title = t(profile.seo.title, lang);
const description = t(profile.seo.description, lang);
const site = Astro.site;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = (l: Lang) => (site ? new URL(`${base}/${langPath(l)}`, site).href : undefined);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Purwokerto', addressCountry: 'ID' },
  alumniOf: 'Universitas Muhammadiyah Purwokerto',
  sameAs: Object.values(profile.links).filter(Boolean),
  ...(site ? { url: pageUrl(lang) } : {}),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#222831" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    {
      site && (
        <>
          <link rel="canonical" href={pageUrl(lang)} />
          <meta property="og:url" content={pageUrl(lang)} />
          {LANGS.map((l) => (
            <link rel="alternate" hreflang={l} href={pageUrl(l)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={pageUrl('en')} />
        </>
      )
    }

    <!-- Marks the page as JS-enabled so reveal animations can start hidden. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">{t(ui.skipToContent, lang)}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 10px 14px;
    background: var(--accent);
    color: var(--ink);
    font-weight: 600;
    transform: translateY(-160%);
    transition: transform 0.3s var(--ease-out);
  }
  .skip:focus {
    transform: none;
  }
</style>
