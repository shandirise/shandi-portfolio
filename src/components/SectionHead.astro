---
import RowLine from './RowLine.astro';
import { pad2 } from '../lib/i18n';

interface Props {
  num: number;
  title: string;
  dek?: string;
  /** Draw the rule under the heading? Off when a table/filter row follows directly. */
  rule?: boolean;
}

const { num, title, dek, rule = true } = Astro.props;
---

<RowLine />
<header class:list={['shead wrap g12', !rule && 'shead--open']}>
  <div class="shead__index" data-reveal style="--i:0">
    <span class="shead__num">({pad2(num)})</span>
    <span class="mono-s muted">{title}</span>
  </div>
  <div class="shead__body">
    <h2 class="h2 mask" data-reveal="mask"><span>{title}</span></h2>
    {dek && <p class="lead muted shead__dek" data-reveal style="--i:2">{dek}</p>}
  </div>
</header>
{rule && <RowLine />}

<style>
  .shead {
    padding-top: 24px;
    padding-bottom: var(--head-gap);
    row-gap: 12px;
  }
  .shead__index {
    grid-column: 1 / span 3;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .shead__num {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0.02em;
    color: var(--accent-text);
  }
  .shead__body {
    grid-column: 4 / -1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .shead__dek {
    max-width: 52ch;
  }
  .shead--open {
    padding-bottom: clamp(24px, 2.8vw, 40px);
  }

  @media (max-width: 1023px) {
    .shead {
      padding-top: 20px;
    }
    .shead__index {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
    }
    .shead__body {
      grid-column: 1 / -1;
      gap: 12px;
    }
  }
</style>
