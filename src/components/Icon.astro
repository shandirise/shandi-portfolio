---
/* Interface icons, drawn to match the design's thin-line glyphs. */
import { siGithub } from 'simple-icons';
import type { IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;

const paths: Record<Exclude<IconName, 'github'>, string> = {
  'arrow-up-right': 'M7 17 17 7M9 7h8v8',
  'arrow-down': 'M12 5v14M6.5 13.5 12 19l5.5-5.5',
  'arrow-up': 'M12 19V5M6.5 10.5 12 5l5.5 5.5',
  download: 'M12 4v11M7 10.5l5 5 5-5M5 20h14',
  plus: 'M12 5v14M5 12h14',
  mail: 'M3.5 6h17v12h-17zM3.5 7l8.5 6.5L20.5 7',
  menu: 'M3 8.5h18M3 15.5h18',
  close: 'M6 6l12 12M18 6 6 18',
  pin: 'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 1 1 13 0c0 5.4-6.5 11-6.5 11ZM12 12.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z',
  linkedin: 'M4 4h16v16H4zM8.25 10.5V17M8.25 7.25v.01M11.75 17v-6.5M11.75 13.25c0-1.6 1-2.75 2.5-2.75s2.25 1 2.25 2.75V17',
};
---

{
  name === 'github' ? (
    <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={siGithub.path} />
    </svg>
  ) : (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="square"
      aria-hidden="true"
    >
      <path d={paths[name]} />
    </svg>
  )
}
