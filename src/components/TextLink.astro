---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { exists, isDev, isExternal, url } from '../lib/assets';
import { nudge } from '../lib/nudge';

interface Props {
  href: string;
  icon?: IconName;
  download?: boolean;
  class?: string;
}

const { href, icon = 'arrow-up-right', download, class: className } = Astro.props;
const missing = !exists(href);
const external = isExternal(href);
// Missing link/file: dashed placeholder in dev, nothing in the published site.
const render = !missing || isDev;
---

{
  render && (
    <a
      class:list={['tlink', missing && 'is-missing', className]}
      href={missing ? undefined : url(href)}
      download={download && !missing ? '' : undefined}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener' : undefined}
      title={missing ? `Missing: ${href || 'add a link'} (see README)` : undefined}
      style={nudge(icon)}
    >
      <span class="tlink__label">
        <slot />
      </span>
      <Icon name={icon} size={16} class="tlink__icon" />
    </a>
  )
}
